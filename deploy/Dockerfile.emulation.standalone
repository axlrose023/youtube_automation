ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim AS base
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

RUN set -eux; \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      build-essential \
      libpq-dev \
      ffmpeg \
      x11vnc \
      xvfb \
      fluxbox \
      novnc \
      websockify \
      x11-utils && \
    rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src

WORKDIR /app

COPY ./backend/pyproject.toml /app
COPY ./backend/uv.lock /app
RUN uv sync --frozen --no-install-project --extra emulation --extra android

COPY ./backend/src /app/src
COPY ./backend/alembic.ini /app
COPY ./backend/scripts/emulation-entrypoint.sh /app/emulation-entrypoint.sh
COPY ./standalone_topic_runner /app/standalone_topic_runner
RUN chmod +x /app/emulation-entrypoint.sh

RUN uv sync --frozen --extra emulation --extra android

# Install Playwright browsers (Chromium) with system deps.
RUN uv run playwright install --with-deps chromium

CMD ["./emulation-entrypoint.sh"]
